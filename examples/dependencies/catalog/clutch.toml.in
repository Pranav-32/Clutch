# prepare.py substitutes the full catalog commit without editing tracked files.
[project]
name = "named-catalog-package"
version = "1.0.0"
language = "cpp"
std = 17
entry = "../main.cpp"

[build]
generator = "ninja"
include_dirs = ["../git-local"]

[dependencies]
number = { vcpkg = "demo-number", root = "../Clutch-build-fixtures/repositories/catalog", baseline = "@CATALOG_BASELINE@", build_system = "clutch", target = "number" }

[[test]]
name = "package-test"
sources = ["../checks/package_test.cpp"]

[profile.debug]
build_dir = "Clutch-build-debug"

[profile.release]
build_dir = "Clutch-build-release"
